# ============================================================
# npm 相关：此文件中列出的全部内容都能通过 npm 命令重新生成
# 注意：package-lock.json 必须提交，用于锁定依赖版本，切勿忽略
# ============================================================

# ---- 依赖目录（npm install / ci 生成）----
node_modules/
.pnpm-store/
.npm/

# ---- 构建产物（npm run build 生成）----
.next/
out/
dist/
build/
*.tsbuildinfo

# ---- 缓存（npm run dev / 构建过程自动生成）----
.next/cache/
.vite/
.cache/
.eslintcache

# ---- npm 运行日志 ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# ---- 环境变量（含密钥，不入库）----
.env
.env.local
.env.*.local
!.env.example

# ---- 部署平台本地缓存（npm 命令顺带生成）----
.vercel/
.netlify/

# ---- macOS 系统文件 ----
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- 编辑器 ----
.vscode/
.idea/
*.swp
*.swo

backend/.venv/
